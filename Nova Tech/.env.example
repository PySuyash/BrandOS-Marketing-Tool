# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server listening port (must be 3000 in AI Studio preview)
PORT=3000

# SESSION_SECRET: Server-side secret used to sign HttpOnly session cookies
SESSION_SECRET="novatech-dev-session-secret-change-in-production"

# DEMO_USER_PASSWORD: Password used when seeding demo accounts
DEMO_USER_PASSWORD="NovaTechDemo2026!"

# BrandOS Integration Configuration
VITE_BRANDOS_URL="http://localhost:5174"
BRANDOS_URL="http://localhost:5174"
BRANDOS_API_URL="http://localhost:5174"
BRANDOS_SSO_SHARED_SECRET="novatech-brandos-shared-secret-change-in-production"
