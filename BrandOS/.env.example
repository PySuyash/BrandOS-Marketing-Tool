# GEMINI_API_KEY: Required for live Gemini AI tone & claim analysis.
# If left empty, BrandOS runs in clearly labelled deterministic demo-review mode.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted (used for cookie security flags).
APP_URL="http://localhost:3000"
PORT=3000;
NODE_ENV="development"

# SESSION_SECRET: Random secret used to sign employee authentication JWTs.
SESSION_SECRET="a7f3c91e8b2d6045f9a1c7e3d6b8f0429e5c1a7d3b6f8092c4e8a5d1f7b9036c"

# DEMO_USER_PASSWORD: Password assigned to seeded @brandos.demo accounts.
DEMO_USER_PASSWORD="BrandOS@Demo2026!"

# PostgreSQL / Cloud SQL connection (auto-injected in AI Studio).
SQL_HOST="127.0.0.1"
SQL_DB_NAME="brandos"
SQL_USER="postgres"
SQL_PASSWORD="replace-with-db-user-password"

# PostgreSQL admin credentials used by Drizzle Kit (npm run db:push).
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="replace-with-db-admin-password"